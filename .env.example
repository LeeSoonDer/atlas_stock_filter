# Copy to .env and fill locally. Never commit real secrets.

# Yahoo Finance (yahoo-finance2 npm package) requires no API key for the
# endpoints used by TASK_CARD_01 (quote, chart/OHLCV, quoteSummary).

# FMP (Financial Modeling Prep) - used by TASK_CARD_05 for post-screen
# top-candidate enrichment (valuation ratios + dual-source price check),
# per constitution/ATLAS_AMENDMENT_NO2_v1_1.md 实施架构.一. Sign up for a
# free key at financialmodelingprep.com. If left unset, TASK_CARD_05's
# FMP enrichment gracefully degrades to 不可得 for every candidate rather
# than failing the run - the rest of the pipeline is unaffected.
FMP_API_KEY=

# Finnhub - reserved for news headlines / earnings calendar.
# Not used by TASK_CARD_01.
FINNHUB_API_KEY=

# FRED (Federal Reserve Economic Data) - used by TASK_CARD_08 Part A for the
# credit-regime circuit breaker (BAMLH0A0HYM2, ICE BofA US High Yield OAS).
# Sign up for a free key at fred.stlouisfed.org/docs/api/api_key.html. If
# left unset, the credit regime degrades to `label: "unknown"` every run
# rather than failing - SMALL_SPEC is never force-disabled and no risk_level
# bump happens, but the rest of the pipeline is unaffected.
FRED_API_KEY=

# SEC EDGAR requires every requester to self-identify via User-Agent (a
# generic UA like "Mozilla/5.0" gets HTTP 403 - verified live). No signup,
# no key needed - but SEC specifically requires an EMAIL-FORMAT string
# (verified live: a descriptive string or URL alone still gets 403; only
# a string containing "name@domain" passes). Set this to your own real,
# reachable contact - SEC's stated purpose is being able to reach you if
# your traffic causes an issue, e.g. "Your Name you@example.com".
# TASK_CARD_04's Form 4 fetcher falls back to a fake-but-well-formed
# placeholder if this is left unset, which passes SEC's format check but
# is NOT a real contact - fine for light/one-off testing, not for
# sustained use.
SEC_EDGAR_USER_AGENT=
